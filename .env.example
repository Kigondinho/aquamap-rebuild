# AquaMap environment template.
# Copy to `.env` and edit. `.env` is git-ignored; never commit real values.
#   cp .env.example .env

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development

# Signs session and pending-2FA tokens. Must be at least 32 characters and must
# not start with "change-me" when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48

SESSION_COOKIE_NAME=aquamap_session
SESSION_TTL_HOURS=12

# Optional email second factor (not part of the proposal baseline).
ENABLE_2FA=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- PostgreSQL / PostGIS ----------------------------------------------------
# When running the app on your host, point at the published port.
# Inside Docker Compose the app service overrides HOST and PORT automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aquamap_db
POSTGRES_USER=aquamap_user
POSTGRES_PASSWORD=change-me

# Connection pool (optional; these are the defaults)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=3
DB_ECHO=false

# Only for running the db tests (pytest -m db) against a disposable database; never commit a real value.
# AQUAMAP_TEST_DATABASE_URL=postgresql+psycopg://aquamap_user:<password>@localhost:5433/aquamap_db

# --- SMTP (only needed if ENABLE_2FA=true) -----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Data --------------------------------------------------------------------
DATA_DIR=data
