# AquaMap environment template.
# Create your .env from it with fresh random secrets (recommended):
#   python3 scripts/init_env.py
# or copy it by hand (cp .env.example .env) and replace every "change-me" value.
# .env is git-ignored; never commit real values.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development

# Signs session and pending-2FA tokens. Must be at least 32 characters and must
# not start with "change-me" when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48

SESSION_COOKIE_NAME=aquamap_session
SESSION_TTL_HOURS=12
# Session cookie: always HttpOnly. Secure is on automatically when APP_ENV=production (HTTPS only);
# leave these unset unless you know you need them.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# One-time codes for email verification and password reset.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Email second factor at sign-in: not built, leave false.
ENABLE_2FA=false

# --- Ports published on this machine (127.0.0.1 only) -------------------------
# Change them if something else already uses 8000 or 5433.
APP_PORT=8000

# --- PostgreSQL / PostGIS ----------------------------------------------------
# When running the app on your host, point at the published port.
# Inside Docker Compose the app service overrides HOST and PORT automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aquamap_db
POSTGRES_USER=aquamap_user
POSTGRES_PASSWORD=change-me

# Connection pool (optional; these are the defaults)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=3
DB_ECHO=false

# Tests: "pytest --test-db" uses the separate database <POSTGRES_DB>_test on the server above (created if missing).
# Only set this to use another test database; its name must end in "_test" or the tests refuse to run.
# AQUAMAP_TEST_DATABASE_URL=postgresql+psycopg://aquamap_user:<password>@localhost:5433/aquamap_db_test

# --- Email -------------------------------------------------------------------
# auto (default): SMTP when SMTP_HOST and SMTP_FROM are set. Otherwise, in development the email
#   (with its one-time code) is written to the server log, and in production email is off.
# smtp | console | none force one behaviour. "console" is refused when APP_ENV=production.
# With email off, new accounts need no verification and password reset by email is unavailable.
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Data --------------------------------------------------------------------
DATA_DIR=data
# User and group the pipeline container writes data/ as (scripts/init_env.py sets them to you).
HOST_UID=1000
HOST_GID=1000
